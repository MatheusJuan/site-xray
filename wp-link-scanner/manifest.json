{
  "manifest_version": 3,
  "name": "SiteXray",
  "version": "1.15.1",
  "description": "Detecta se o site atual roda WordPress, lista links públicos sensíveis e rastreadores/pixels carregados na página.",
  "permissions": ["activeTab", "scripting", "cookies", "sidePanel", "storage"],
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "popup.html" },
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "action": {
    "default_title": "SiteXray",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  }
}
